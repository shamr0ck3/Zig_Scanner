fast_port_scan() {
    local host="$1"
    local ports="$2"
    local open_ports=()
    local t_cmd="timeout"
    
    # Termux/Android sometimes uses 'busybox timeout'
    command -v timeout >/dev/null || t_cmd="busybox timeout"

    IFS=',' read -ra port_list <<< "$ports"
    for port in "${port_list[@]}"; do
        $t_cmd 5 bash -c "echo >/dev/tcp/$host/$port" 2>/dev/null && open_ports+=("$port")
    done
    echo "${open_ports[@]}"
}

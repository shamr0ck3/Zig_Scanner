#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════╗
# ║   SUBPROBE v2.0 — Subdomain Enum + HTTP Probe Pipeline       ║
# ║   Flow: Enum → Resolve → HTTP Probe → Live Filter            ║
# ║   by shamr0ck3 | Termux Ready | Optimized & Hardened         ║
# ╚═══════════════════════════════════════════════════════════════╝

# ── Cleanup Trap ──────────────────────────────────────────────────
# Ensures temp files are deleted even if the script is interrupted
trap 'rm -f /tmp/subprobe_*; exit' INT TERM EXIT

# ── Colors ────────────────────────────────────────────────────────
R="\e[0m"; BOLD="\e[1m"; DIM="\e[2m"; CYAN="\e[1;36m"; GREEN="\e[1;32m"
YELLOW="\e[1;33m"; RED="\e[1;31m"; MAGENTA="\e[1;35m"; BLUE="\e[1;34m"

# ── Status code color map ─────────────────────────────────────────
status_color() {
    case "$1" in
        2*) echo -e "${GREEN}$1${R}" ;;
        301|302|303|307|308) echo -e "${CYAN}$1${R}" ;;
        3*) echo -e "${BLUE}$1${R}" ;;
        403|401) echo -e "${YELLOW}$1${R}" ;;
        4*) echo -e "${DIM}$1${R}" ;;
        5*) echo -e "${RED}$1${R}" ;;
        *)  echo -e "${DIM}???${R}" ;;
    esac
}

banner() {
    echo -e "${CYAN}██╗      ██████╗ ██╗  ██╗███████╗${R}"
    echo -e "${CYAN}██║     ██╔═══██╗╚██╗██╔╝██╔════╝${R}"
    echo -e "${CYAN}██║     ██║   ██║ ╚███╔╝ ███████╗${R}"
    echo -e "${CYAN}██║     ██║   ██║ ██╔██╗ ╚════██║${R}"
    echo -e "${CYAN}███████╗╚██████╔╝██╔╝ ██╗███████║${R}"
    echo -e "${CYAN}╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝${R}"
    echo -e "${MAGENTA}  Optimized Subdomain Discovery & Probing${R}\n"
}

usage() {
    echo -e "${CYAN}Usage:${R}  $0 ${YELLOW}<domain>${R} ${DIM}[options]${R}"
    echo -e "\n${CYAN}Options:${R}"
    echo -e "  ${GREEN}-o <dir>${R}    Output directory"
    echo -e "  ${GREEN}-t <sec>${R}    HTTP timeout (default: auto)"
    echo -e "  ${GREEN}-c <n>${R}      Concurrency/Threads (default: auto)"
    echo -e "  ${GREEN}-f <codes>${R}  Filter codes (default: 200,301,302,403)"
    echo -e "  ${GREEN}-v${R}          VPN mode (Conservative settings)"
    echo -e "  ${GREEN}-s${R}          Skip enum, use existing subs.txt"
    echo -e "  ${GREEN}-q${R}          Quiet mode"
    exit 0
}

log()  { [[ $QUIET -eq 0 ]] && echo -e "  ${CYAN}[*]${R} $*"; }
ok()   { echo -e "  ${GREEN}[✓]${R} $*"; }
warn() { [[ $QUIET -eq 0 ]] && echo -e "  ${YELLOW}[!]${R} $*"; }
err()  { echo -e "  ${RED}[✗]${R} $*"; }
dim()  { [[ $QUIET -eq 0 ]] && echo -e "  ${DIM}    $*${R}"; }

# ── Network Auto-tune ─────────────────────────────────────────────
autotune() {
    local ping_host="8.8.8.8"
    local avg_ms
    avg_ms=$(ping -c 3 -W 2 "$ping_host" 2>/dev/null | awk -F'/' 'END {print $5}' | cut -d. -f1)

    if [[ -z "$avg_ms" ]]; then
        echo "10 8" # Fallback
        return
    fi
    if   (( avg_ms < 50 ));  then echo "5 30"
    elif (( avg_ms < 100 )); then echo "8 20"
    else                          echo "12 10"; fi
}

clean_subs() {
    sed 's/\*\.//g' | tr '[:upper:]' '[:lower:]' | \
    grep -E "^([a-z0-9]([a-z0-9\-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$"
}

# ── Enumeration Sources ───────────────────────────────────────────
fetch_crtsh() {
    dim "Source: crt.sh"
    curl -sL --max-time $((TIMEOUT+5)) "https://crt.sh/?q=%25.$1&output=json" | jq -r '.[].name_value' 2>/dev/null | clean_subs
}

fetch_otx() {
    dim "Source: AlienVault OTX"
    curl -sL --max-time $((TIMEOUT+5)) "https://otx.alienvault.com/api/v1/indicators/domain/$1/passive_dns" | jq -r '.passive_dns[]?.hostname' 2>/dev/null | clean_subs
}

fetch_hackertarget() {
    dim "Source: HackerTarget"
    curl -sL --max-time $((TIMEOUT+5)) "https://api.hackertarget.com/hostsearch/?q=$1" | cut -d',' -f1 2>/dev/null | clean_subs
}

# ── Core Phases ───────────────────────────────────────────────────
run_enum() {
    local domain="$1" outfile="$2"
    local tmp; tmp=$(mktemp ./subprobe_enum_XXXX.tmp)
    log "Phase 1: Enumeration"
    
    fetch_crtsh "$domain" >> "$tmp"
    fetch_otx "$domain" >> "$tmp"
    fetch_hackertarget "$domain" >> "$tmp"

    sort -u "$tmp" | grep "\.${domain}$" | # grep -v "^${domain}$" > "$outfile"
    ok "Found $(wc -l < "$outfile") unique subdomains."
}

run_resolve() {
    local subfile="$1" outfile="$2"
    log "Phase 2: DNS Resolution"
    > "$outfile"
    
    while read -r sub; do
        # Use 'host' for speed if available, else 'dig'
        if command -v host >/dev/null; then
            host "$sub" >/dev/null && echo "$sub" >> "$outfile" && [[ $QUIET -eq 0 ]] && echo -e "  ${GREEN}✓${R} $sub" &
        else
            dig +short "$sub" | grep -qE '^[0-9]' && echo "$sub" >> "$outfile" && [[ $QUIET -eq 0 ]] && echo -e "  ${GREEN}✓${R} $sub" &
        fi
        
        # Simple parallel throttle for DNS
        [[ $(jobs -r | wc -l) -gt 20 ]] && wait -n
    done < "$subfile"
    wait
    ok "Resolved $(wc -l < "$outfile") hosts."
}

# ── Banner Grabbing ────────────────────────────────────────────────
grab_banner() {
    local host="$1"
    local port="$2"
    local banner=""
    
    case $port in
        22)
            banner=$(timeout 3 nc -vn "$host" 22 2>&1 | grep -E "^SSH" | head -1)
            ;;
        80|443)
            banner=$(curl -I -s --max-time 3 "http://$host" 2>/dev/null | grep -i "^Server:" | cut -d" " -f2-)
            ;;
        21)
            banner=$(timeout 3 nc -vn "$host" 21 2>&1 | head -1)
            ;;
        *)
            banner="unknown"
            ;;
    esac
    echo "$banner"
}

probe_url() {
    local url="$1" timeout="$2" filterfile="$3" livefile="$4"
    local code
    # --path-as-is ensures raw paths aren't collapsed by curl
    code=$(curl -I -s -o /dev/null --max-time "$timeout" --connect-timeout 5 \
        --path-as-is -w "%{http_code}" \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" "$url" 2>/dev/null)

    if grep -qw "$code" "$filterfile" 2>/dev/null; then
        echo -e "  ${BOLD}${url#*//}${R} → $(status_color "$code")"
        echo "$url|$code" >> "$livefile"
    fi
}

run_probe() {
    local resolved_file="$1" outfile="$2" timeout="$3" concurrency="$4" filter_codes="$5"
    log "Phase 3: HTTP Probing (Threads: $concurrency)"
    
    local f_tmp; f_tmp=$(mktemp ./subprobe_filter_XXXX.tmp)
    echo "$filter_codes" | tr ',' '\n' > "$f_tmp"
    > "$outfile"

    while read -r sub; do
        for scheme in https http; do
            probe_url "$scheme://$sub" "$timeout" "$f_tmp" "$outfile" &
            
            # Efficient Job Management: Wait for at least one to finish before spawning more
            while [[ $(jobs -r | wc -l) -ge $concurrency ]]; do
                sleep 0.1
                wait -n 2>/dev/null || wait # Fallback for older Bash
            done
        done
    done < "$resolved_file"
    wait
}

# ── Main ──────────────────────────────────────────────────────────
main() {
    banner
    [[ $# -eq 0 ]] && usage

    local domain="$1"; shift
    local outdir="" filter_codes="200,301,302,403"
    local skip_enum=0 vpn_mode=0
    QUIET=0; TIMEOUT=0; local concurrency=0

    while getopts "o:t:c:f:vsqh" opt; do
        case $opt in
            o) outdir="$OPTARG" ;;
            t) TIMEOUT="$OPTARG" ;;
            c) concurrency="$OPTARG" ;;
            f) filter_codes="$OPTARG" ;;
            v) vpn_mode=1 ;;
            s) skip_enum=1 ;;
            q) QUIET=1 ;;
            *) usage ;;
        esac
    done

    # Tuning Logic
    if [[ $vpn_mode -eq 1 ]]; then
        TIMEOUT=${TIMEOUT:-12}; concurrency=${concurrency:-8}
    else
        read -r auto_t auto_c < <(autotune)
        TIMEOUT=${TIMEOUT:-$auto_t}; concurrency=${concurrency:-5}
    fi
    export TIMEOUT

    outdir=${outdir:-"./recon_$domain"}
    mkdir -p "$outdir"
    
    local subs_f="$outdir/subs.txt"
    local res_f="$outdir/resolved.txt"
    local live_f="$outdir/live.txt"

    [[ $skip_enum -eq 0 ]] && run_enum "$domain" "$subs_f"
    [[ -s "$subs_f" ]] && run_resolve "$subs_f" "$res_f"
    [[ -s "$res_f" ]] && run_probe "$res_f" "$live_f" "$TIMEOUT" "$concurrency" "$filter_codes"

    echo -e "\n${GREEN}${BOLD}Scan Finished.${R} Results in ${CYAN}$outdir${R}"
}

main "$@"

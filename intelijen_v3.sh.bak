echo -e "Zig_Scanner v3.1 - Termux Non-Root Edition\033[0m"
echo "======================================================="
echo -e "\033[1;33m[*] Optimized for Termux non-root environment\033[0m"
echo -e "\033[1;33m[*] Using TCP connect scans and safe NSE scripts\033[0m"

# ====== FUNCTIONS ======

# ====== V4.2 FUNCTION LIBRARY ======

anti_cloaking_check() {
    echo -e "\n\033[1;33m[+] Anti-Cloaking & Evasion Check:\033[0m"
    local target_url=$1
    local mobile_size=$(curl -sL -A "Mozilla/5.0 (Linux; Android 14)" "$target_url" | wc -c)
    local bot_size=$(curl -sL -A "Googlebot/2.1" "$target_url" | wc -c)
    echo "    [*] Mobile: $mobile_size bytes | Bot: $bot_size bytes"
}

stego_asset_scan() {
    echo -e "\n\033[1;33m[+] Steganography Asset Analysis:\033[0m"
    [ -f "defender_scan.py" ] && echo "    [*] defender_scan.py active." || echo "    [!] defender_scan.py missing."
}

fuzz_xss_bypass() {
    echo -e "\n\033[1;33m[+] XSS WAF Bypass Fuzzing:\033[0m"
    echo "    [*] Initializing fuzzer module..."
}

launch_xsstrike() {
    echo -e "\n\033[1;35m[!] XSStrike Automation Ready."
}

# FIX: Merged both check_dependencies into one clean version.
# Removed broken first definition (malformed escape, missing fi/}).
# pkg install only runs if the tool is genuinely missing.
check_dependencies() {
    echo -e "\033[1;36m[+] Checking for required tools...\033[0m"
    local missing_tools=()
    local tools=("nmap" "httpx" "jq" "curl" "python3" "ncat" "awk" "cut" "grep" "sed" "dig" "whois" "nping")
    for cmd in "${tools[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_tools+=("$cmd")
        fi
    done
    if [ ${#missing_tools[@]} -gt 0 ]; then
        echo -e "\033[1;33m[!] Missing tools: ${missing_tools[*]}\033[0m"
        echo -e "\033[1;36m[*] Attempting to install missing tools via pkg...\033[0m"
        for tool in "${missing_tools[@]}"; do
            pkg install -y "$tool" 2>/dev/null || echo -e "\033[1;31m[!] Could not install: $tool\033[0m"
        done
    else
        echo -e "\033[1;32m[✓] All required tools found.\033[0m"
    fi
}

random_ua() {
    echo "${USER_AGENTS[$RANDOM % ${#USER_AGENTS[@]}]}"
}

random_sleep() {
    if [ ${#SLEEP_INTERVALS[@]} -eq 0 ]; then
        sleep 1
    else
        sleep "${SLEEP_INTERVALS[$RANDOM % ${#SLEEP_INTERVALS[@]}]}"
    fi
}

# FIX: Restored missing waf_detection() body. Previously only the closing
# lines (waf_detected_status assignment) existed; the full function was gone.
waf_detection() {
    echo -e "\n\033[1;33m[+] WAF Detection:\033[0m"
    random_sleep
    local target_url="$1"
    if [[ ! "$target_url" =~ ^https?:// ]]; then
        target_url="http://$target_url"
    fi

    local waf_detected_status="false"
    echo "    Probing: $target_url"

    local response_headers
    response_headers=$(curl -sI -A "$(random_ua)" "$target_url" 2>/dev/null)

    # Check for common WAF signatures in headers
    if echo "$response_headers" | grep -qiE "x-sucuri|x-firewall|cf-ray|x-waf|akamai|incapsula|mod_security|x-cdn"; then
        echo -e "\033[1;31m    [!] WAF/CDN Detected (header signatures found)\033[0m"
        waf_detected_status="true"
    fi

    # Check for WAF via blocked payload response
    local waf_test_url="${target_url}/?q=<script>alert(1)</script>"
    local waf_response
        # Rotate headers to bypass Cloudflare rate-limiting
        local random_ip="$((RANDOM%255)).$((RANDOM%255)).$((RANDOM%255)).$((RANDOM%255))"
        response=$(curl -sL -A "$(random_ua)" \
            -H "X-Forwarded-For: $random_ip" \
            -H "Client-IP: $random_ip" \
            --connect-timeout 5 "$test_url" 2>/dev/null)
    if [[ "$waf_response" == "403" || "$waf_response" == "406" || "$waf_response" == "429" ]]; then
        echo -e "\033[1;31m    [!] WAF Detected (blocked payload → HTTP $waf_response)\033[0m"
        waf_detected_status="true"
    fi

    if [ "$waf_detected_status" = "false" ]; then
        echo -e "\033[1;32m    [✓] No WAF detected.\033[0m"
    fi

    WAF_STATUS="$waf_detected_status"
}

# FIX: All buffering_animation calls now pass PID explicitly using $! captured
# immediately after backgrounding the subshell.




ncat_scan() {
    echo -e "\n\033[1;33m[+] Ncat Service Probing:\033[0m"
    random_sleep
    local target_host=""
    if [[ "$1" =~ ^https?:// ]]; then
        target_host=$(echo "$1" | awk -F/ '{print $3}' | cut -d: -f1)
    else
        target_host="$1"
    fi
    for port in 80 443; do
        if nmap -p"$port" "$target_host" | grep -q "$port/tcp open"; then
            echo "    Testing HTTP/$port on $target_host..."
            printf $'GET / HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n' "$target_host" | \
                ncat -w "$NCAT_TIMEOUT" "$target_host" "$port" > ncat_$port.txt &
            buffering_animation $!
            cat ncat_$port.txt
        else
            echo "    Port $port on $target_host is not open. Skipping Ncat probe."
        fi
    done
}

nping_scan() {
    echo -e "\n\033[1;33m[+] Nping Connectivity Test:\033[0m"
    random_sleep
    local target_host=""
    if [[ "$1" =~ ^https?:// ]]; then
        target_host=$(echo "$1" | awk -F/ '{print $3}' | cut -d: -f1)
    else
        target_host="$1"
    fi
    echo "    TCP Connect mode (Termux non-root)"
    nping --tcp-connect -c 2 "$target_host" > nping_output.txt &
    buffering_animation $!
    cat nping_output.txt
}

header_analysis() {
    echo -e "\n\033[1;33m[+] HTTP Header Analysis:\033[0m"
    random_sleep
    local target_url="$1"
    if [[ ! "$target_url" =~ ^https?:// ]]; then
        target_url="http://$target_url"
    fi
    echo "    Scanning: $target_url"

    if command -v httpx &> /dev/null; then
        echo "    Using httpx for header analysis..."
        httpx -url "$target_url" -status-code -title -web-server -content-type -tech-detect -json -silent > httpx_output.json &
        buffering_animation $!
        if [ -f "httpx_output.json" ] && jq . < httpx_output.json &>/dev/null; then
            jq . < httpx_output.json
        else
            echo -e "\033[1;33m[!] httpx output was not valid JSON. Falling back to curl.\033[0m"
            curl -sI -A "$(random_ua)" "$target_url" > headers.txt &
            buffering_animation $!
        fi
    else
        echo -e "\033[1;33m[!] httpx not found. Using curl fallback.\033[0m"
        curl -sI -A "$(random_ua)" "$target_url" > headers.txt &
        buffering_animation $!
    fi

    if [ -f "headers.txt" ]; then
        echo -e "\n--- Raw Headers from curl ---"
        cat headers.txt
        echo -e "-----------------------------"
    fi
}

threat_intel_check() {
    echo -e "\n\033[1;33m[+] Threat Intelligence Check:\033[0m"
    random_sleep
    local target_input="$1"
    local domain="" ip=""

    if [[ "$target_input" =~ ^https?:// ]]; then
        domain=$(echo "$target_input" | awk -F/ '{print $3}' | cut -d: -f1)
    elif [[ "$target_input" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
        ip="$target_input"
    else
        domain="$target_input"
    fi

    if [ -n "$domain" ]; then
        echo "    Domain: $domain"
        ip=$(dig +short A "$domain" | head -n1 2>/dev/null)
        [ -n "$ip" ] && echo "    Resolved IP: $ip" || echo "    [!] Could not resolve IP for domain: $domain"
    elif [ -n "$ip" ]; then
        echo "    IP: $ip"
    else
        echo "    [!] Could not determine domain or IP for threat intelligence check."
        return
    fi

    if [ -f "$THREAT_INTEL_DB" ] && [ -n "$ip" ]; then
        if grep -qF "$ip" "$THREAT_INTEL_DB"; then
            echo -e "\033[1;31m[!] BLACKLISTED IP: $ip (found in local threat intel DB)\033[0m"
        fi
    fi

    if [[ "$target_input" =~ (c2server|malware|phish) ]] || \
       [[ "$target_input" =~ \.(php|asp)\?cmd= ]]; then
        echo -e "\033[1;31m[!] Suspicious URL Pattern Detected!\033[0m"
    fi
}

get_target_geolocation() {
    echo -e "\n\033[1;33m[+] Geolocation Lookup:\033[0m"
    random_sleep
    local target_ip=""

    if [ -n "$target_ip" ]; then
        echo "    Looking up geolocation for IP: $target_ip"
        python3 checkip.py "$target_ip" > geolocation_output.json &
        buffering_animation $!
        if [ -f "geolocation_output.json" ] && jq . < geolocation_output.json &>/dev/null; then
            echo -e "\033[1;32m[✓] Geolocation Data:\033[0m"
            jq . < geolocation_output.json | sed 's/^/        /'
        else
            echo -e "\033[1;33m[!] Failed to get or parse geolocation data for $target_ip.\033[0m"
        fi
        rm -f geolocation_output.json 2>/dev/null
    else
        echo -e "\033[1;33m[!] Could not resolve IP for geolocation lookup.\033[0m"
    fi
}

honeypot_scan() {
    echo -e "\n\033[1;33m[+] Honeypot Detection:\033[0m"
    random_sleep
    local target_url="$1"
    [[ ! "$target_url" =~ ^https?:// ]] && target_url="http://$target_url"
    echo "    Running honeypot detection on: $target_url"
    local honeypot_output
    honeypot_output=$(python3 "$HONEYPOT_DETECTOR_SCRIPT" "$target_url" 2>&1)
    echo "$honeypot_output" | sed 's/^/    /'
    if echo "$honeypot_output" | grep -qi "Honeypot detected: YES"; then
        echo -e "\033[1;31m    [!] Strong honeypot indicators detected!\033[0m"
    else
        echo -e "\033[1;32m    [✓] No strong honeypot indicators found.\033[0m"
    fi
}

run_analysis() {
    echo -e "\n\033[1;36m[+] Running Security Analysis:\033[0m"
    if [ ! -d "$PAYLOADS_DIR" ]; then
        echo -e "\n\033[1;31m[!] Error: PayloadsAllTheThings missing.\033[0m"
        return
    fi
    [ -f "$PY_ANALYZER" ] && python3 "$PY_ANALYZER" & buffering_animation $!
}
update_threat_intel() {
    echo -e "\033[1;36m[+] Updating Threat Intelligence DB...\033[0m"
    if curl -sf "$EXTERNAL_C2_FEED" -o threat_feed_tmp.txt 2>/dev/null; then
        mv threat_feed_tmp.txt "$THREAT_INTEL_DB"
        echo -e "\033[1;32m[✓] Threat intel DB updated.\033[0m"
    else
        echo -e "\033[1;33m[!] Could not fetch threat feed. Using existing DB if available.\033[0m"
        rm -f threat_feed_tmp.txt
    fi
}

sql_injection_probe() {
    echo -e "\n\033[1;33m[+] SQL Injection Probing (JDT-Mobile Engine):\033[0m"
    local target_url=$1
    local sql_payloads=(
        "' OR '1'='1"
        "'-- "
        "admin'--"
        "' UNION SELECT NULL,NULL,NULL--"
        "sleep(5)#"
        "' AND 1=1--"
    )
    for payload in "${sql_payloads[@]}"; do
        local encoded_payload
        encoded_payload=$(python3 -c "import urllib.parse; print(urllib.parse.quote('''$payload'''))")
        local test_url
        if [[ "$target_url" == *"?"* ]]; then
            test_url="${target_url}${encoded_payload}"
        else
            test_url="${target_url}/?id=${encoded_payload}"
        fi
        echo -ne "    [*] Testing: $payload\r"
        local response
        # Rotate headers to bypass Cloudflare rate-limiting
        local random_ip="$((RANDOM%255)).$((RANDOM%255)).$((RANDOM%255)).$((RANDOM%255))"
        response=$(curl -sL -A "$(random_ua)" \
            -H "X-Forwarded-For: $random_ip" \
            -H "Client-IP: $random_ip" \
            --connect-timeout 5 "$test_url" 2>/dev/null)
        if echo "$response" | grep -qiE "sql|mysql|sqlite|postgresql|oracle|syntax error|unexpected"; then
            echo -e "\n\033[1;31m    [!] POTENTIAL SQLi DETECTED: $payload\033[0m"
            echo "    [SQLi] Test URL: $test_url" >> "$LOG_FILE"
        fi
    done
    echo -e "\n    [✓] SQLi Probe Complete."
}
nse_scan() {
    echo -e "\n[5/6] Section: NSE Script Scanning"
    local clean_target=$(echo "$1" | sed -E 's|^https?://||' | cut -d/ -f1)
    local host=$(echo "$clean_target" | cut -d: -f1)

    echo -e "\n    [*] Running safe scripts: $NSE_SAFE_SCRIPTS"
    {
        echo -e "\n[✓] Safe NSE Scan Results for $clean_target:" >> "$LOG_FILE"
        nmap -sV -Pn -p"$SCAN_PORTS" --script="$NSE_SAFE_SCRIPTS" "$host" >> "$LOG_FILE"
    } &
    buffering_animation $!

    if [ "$AGGRESSIVE_MODE" = true ]; then
        echo -e "\n    [!] Aggressive NSE scripts enabled!"
        {
            echo -e "\n[!] Aggressive NSE Scan Results for $clean_target (Vuln Scripts):" >> "$LOG_FILE"
            nmap -sV -Pn -p"$SCAN_PORTS" --script="$NSE_AGGRESSIVE_SCRIPTS" "$host" >> "$LOG_FILE" 2>> "$LOG_FILE"
        } &
        buffering_animation $!
    else
        echo -e "    [~] Aggressive mode disabled. Skipping vuln NSE scan."
    fi
}

# ====== MASTER CONTROLLER ======
# 1. Start the engine
mkdir -p "$LOG_DIR"
check_dependencies
update_threat_intel

# 2. Get the target
echo -ne "\n"
read -p "Enter Target (domain/IP/URL): " target
if [ -z "$target" ]; then echo -e "\033[1;31m[!] Error: Target required.\033[0m"; exit 1; fi

read -p "Enable aggressive mode? (y/N): " agg_opt
[[ "$agg_opt" =~ ^[Yy]$ ]] && AGGRESSIVE_MODE=true || AGGRESSIVE_MODE=false

# 3. Run the Recon Pipeline
waf_detection "$target"
honeypot_scan "$target"
port_scan "$target"
nse_scan "$target"
get_target_geolocation "$target"
header_analysis "$target"
anti_cloaking_check "$target"
stego_asset_scan "$target"   # FIX: Removed duplicate call that followed this
threat_intel_check "$target"
fuzz_xss_bypass "$target"
sql_injection_probe "$target"

# 4. Run the Active Exploit Modules
# check_sqli "$target"
# fuzz_parameters "$target"

# 5. Cleanup & Wrap up
rm -f nmap_port_scan.txt headers.txt ncat_*.txt nping_output.txt httpx_output.json 2>/dev/null
echo -e "\n\033[1;32m[+] SUCCESS: Full audit log saved to: $LOG_FILE\033[0m"

# ====== AUTO-VAULT SYNC (JDT-MOBILE) ======
if [ -f "$LOG_FILE" ]; then
    echo -e "\n\033[1;34m[↑] Securing scan results to Private Vault...\033[0m"
    git add "$LOG_FILE"
    git commit -m "Auto-Log: $target ($(date +%H:%M))" --quiet
    git push origin main --quiet
    echo -e "\033[1;32m[✓] Intel successfully synced to GitHub.\033[0m"
else
    echo -e "\033[1;31m[!] No log file found to sync.\033[0m"
fi
